# ==============================================================================
# MAD O MEDIA • AGENCY OS — PRODUCTION ENVIRONMENT CONFIGURATION (HOSTINGER)
# ==============================================================================
# Instructions:
# 1. Rename this file to `.env` on your Hostinger server or copy these values into
#    Hostinger hPanel -> Web App -> Environment Variables.
# 2. Generate secrets by running: npm run secrets:generate
# 3. Ensure SEED_DEMO is strictly set to false.
# ==============================================================================

# Core Production Settings
NODE_ENV=production
PORT=3100
# Your live production domain with HTTPS (must start with https://)
APP_URL=https://crm.mad0media.com

# Reverse Proxy Trust (Required on Hostinger Web App behind Nginx)
TRUST_PROXY=1

# Hostinger MySQL Database
# Format: mysql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]?connection_limit=15&pool_timeout=30
# If your database is on the same Hostinger account, host is usually 'localhost' or '127.0.0.1'.
# If remote, use the MySQL IP or hostname provided in hPanel -> Databases.
DATABASE_URL=mysql://u123456789_agencyos:CHANGE_TO_YOUR_DB_PASSWORD@localhost:3306/u123456789_agencyos?connection_limit=15&pool_timeout=30

# Cryptographic Authentication Secrets (64-character hex strings)
# Generate with: npm run secrets:generate
JWT_SECRET=GENERATE_WITH_NPM_RUN_SECRETS_GENERATE
CRON_SECRET=GENERATE_WITH_NPM_RUN_SECRETS_GENERATE

# Initial Super Admin (Created during npm run db:setup:prod)
# The owner will be required to set their private password upon first login.
SEED_ADMIN_EMAIL=owner@mad0media.com
SEED_ADMIN_NAME=Aditya Khan
SEED_ADMIN_PASSWORD=SET_A_SECURE_INITIAL_PASSWORD_12_CHARS_MIN

# CRITICAL: Keep SEED_DEMO=false to prevent any mock records from being injected.
SEED_DEMO=false

# Optional Integrations (Configure in Settings when live)
# Resend Email Delivery
RESEND_API_KEY=
EMAIL_FROM=Mad O Media <notifications@mad0media.com>

# WhatsApp Cloud API (Optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=agency_workflow_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# Realtime WebSocket Studio Updates (Pusher Channels)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
